# Streamlit Secrets Configuration
# Copy this file and rename to secrets.toml (do not commit secrets.toml!)
# Or add these values in Streamlit Cloud dashboard under Settings > Secrets

# AI API Keys (optional - for news analysis)
OPENAI_API_KEY = "sk-your-openai-key-here"
ANTHROPIC_API_KEY = "sk-ant-your-anthropic-key-here"

# Email Alerts (optional)
EMAIL_ADDRESS = "your-email@gmail.com"
EMAIL_PASSWORD = "your-gmail-app-password"
EMAIL_RECIPIENTS = "recipient1@example.com,recipient2@example.com"

# Slack Alerts (optional)
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Dashboard Password Protection (optional)
# Uncomment to enable password protection
# app_password = "your-secure-password-here"
